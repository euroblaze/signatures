<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="user_signature_by_company_view_form" model="ir.ui.view">
            <field name="name">user_signature_by_company_inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='signature']" position="replace">
                    <field name="x_use_user_signatures"/>
                    <field name="x_user_signature_id"
                           invisible="not x_use_user_signatures"
                           style="width: 20%"/>
                    <field name="signature"
                           readonly="False"
                           options="{'style-inline': true, 'codeview': true}"/>
                </xpath>
            </field>
        </record>
        <record id="user_signature_res_users_view_form" model="ir.ui.view">
            <field name="name">user_signature_res_users_view_form_inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='signature']" position="replace">
                    <field name="x_use_user_signatures"/>
                    <field name="x_user_signature_id"
                           invisible="not x_use_user_signatures"
                           style="width: 20%"/>
                    <field name="signature"
                           readonly="False"
                           options="{'style-inline': true, 'codeview': true}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>