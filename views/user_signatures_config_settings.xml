<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_user_signatures" model="ir.ui.view">
        <field name="name">res.config.settings.view.user.signatures</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="inside">
                <setting string="User Signatures" help="Configure User Signatures by Company">
                    <field name="x_user_signatures"/>
                    <div class="mt8" invisible="not x_user_signatures">
                        <button type="action"
                                name="signatures.user_signatures_action"
                                string="Manage User Signatures"
                                icon="fa-arrow-right"
                                class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
