<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="user_signatures_view_form" model="ir.ui.view">
            <field name="name">Add User Signatures by Company</field>
            <field name="model">user.signatures</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="x_name"/>
                            </h1>
                        </div>
                        <group name="group_top">
                            <group name="group_left">
                                <field name="x_employee_id"/>
                                <field name="x_company_id" widget="selection"/>
                            </group>
                        </group>
                        <group name="group_down">
                            <field name="x_signature" widget="html"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="user_signatures_view_tree" model="ir.ui.view">
            <field name="name">User Signatures by Company List</field>
            <field name="model">user.signatures</field>
            <field name="arch" type="xml">
                <list default_order="x_company_id">
                    <field name="x_name"/>
                    <field name="x_employee_id"/>
                    <field name="x_company_id"/>
                    <field name="x_signature" widget="html" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="user_signatures_view_search" model="ir.ui.view">
            <field name="name">User Signatures by Company Search</field>
            <field name="model">user.signatures</field>
            <field name="arch" type="xml">
                <search>
                    <field name="x_name"/>
                    <field name="x_employee_id"/>
                    <field name="x_company_id"/>
                    <field name="x_signature" widget="html"/>
                </search>
            </field>
        </record>
        <record id="user_signatures_action" model="ir.actions.act_window">
            <field name="name">User Signatures</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">user.signatures</field>
            <field name="domain">[('x_company_id','in',allowed_company_ids)]</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first signature!
                </p>
                <p>
                    Set up specific signatures per company to brand your email communications.
                    Each user can create signatures for themselves for each available company.
                </p>
            </field>
        </record>

        <!-- Menu Structure -->
        <menuitem id="signatures_main_menu"
                  name="Signatures"
                  sequence="50"/>

        <menuitem id="signatures_config_menu"
                  name="Configuration"
                  parent="signatures_main_menu"
                  sequence="10"/>

        <menuitem id="user_signatures_menu"
                  name="User Signatures"
                  parent="signatures_config_menu"
                  action="user_signatures_action"
                  sequence="10"/>
    </data>
</odoo>